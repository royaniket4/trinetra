# Trinetra SIEM - Environment Configuration
# Copy this to .env and fill in your values

# ==========================================
# BASIC SETTINGS
# ==========================================

# Application name and version
APP_NAME=Trinetra
APP_VERSION=1.0.0

# Environment (development/production)
ENVIRONMENT=development

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# SQLite (default for development)
DATABASE_URL=sqlite:///./trinetra.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/trinetra

# Database pool settings (for PostgreSQL)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ==========================================
# API & CORS
# ==========================================

# API prefix
API_PREFIX=/api

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# SECURITY
# ==========================================

# JWT Secret - IMPORTANT: Change this in production!
JWT_SECRET=trinetra-secure-secret-change-this-in-production-abc123

# Token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Security headers
SECURITY_HEADERS_ENABLED=true

# ==========================================
# WEBSOCKET
# ==========================================

WS_ENDPOINT=/ws

# ==========================================
# AI CONFIGURATION (TrinetraMind)
# ==========================================

# Primary AI Provider: ollama, openai, anthropic, huggingface, custom
AI_PROVIDER=ollama
AI_FALLBACK_ENABLED=true

# --- Ollama Settings (Local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=1024
OLLAMA_TIMEOUT=120

# --- OpenAI Settings (Cloud - Fallback) ---
# OPENAI_API_KEY=sk-...

# --- Anthropic Claude Settings (Cloud - Fallback) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- HuggingFace Settings ---
# HUGGINGFACE_API_TOKEN=...
# HUGGINGFACE_MODEL=meta-llama/Llama-2-7b-chat-hf

# --- Custom API Settings ---
# CUSTOM_API_URL=https://api.example.com/v1
# CUSTOM_API_KEY=...
# CUSTOM_API_MODEL=gpt-4

# ==========================================
# REDIS CACHE (Optional - for production)
# ==========================================

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ==========================================
# SIMULATOR (Development only)
# ==========================================

SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MIN=5
SIMULATOR_INTERVAL_MAX=30

# ==========================================
# SOAR (Security Orchestration)
# ==========================================

AUTO_RESPONSE_ENABLED=false
AUTO_RESPONSE_SEVERITY_THRESHOLD=5

# ==========================================
# STATS & MONITORING
# ==========================================

STATS_CACHE_TTL=5
LOG_LEVEL=INFO
LOG_FORMAT=json  # or text

# ==========================================
# REPORTING (Email & Webhooks)
# ==========================================

# SMTP Settings for email reports
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_FROM=trinetra@example.com

# Webhook URLs (comma-separated)
# WEBHOOK_URLS=https://hooks.slack.com/...,https://hooks.pagerduty.com/...